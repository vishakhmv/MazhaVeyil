# Copy to .env (never commit .env). Names only here.
PORT=3001
# Optional. Free key: https://aistudio.google.com/apikey . Without one, photos are answered with a clearly flagged sample bill.
# After adding it run:  npm run check:gemini   (scans samples/test-bill.png and prints PASS or FAIL)
GEMINI_API_KEY=
# Optional: pin one model (default: tries gemini-3.5-flash-lite, then gemini-3.6-flash, then gemini-2.5-flash)
# GEMINI_MODEL=
# Secret salt for hashing roof ids into anonymous household keys: change it before the event
HOUSEHOLD_SALT=change_me_before_the_event
# Optional: where the SQLite file lives (default: community/mazhaveyil.sqlite)
# DATABASE_PATH=
